# Environment variables template
# Copy to .env and fill in values before running

# Service Configuration
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO

# Knowledge Base Path (absolute or relative to the project root)
# RAG_KB_PATH=data/knowledge_base.json

# LiteLLM Configuration (for generation feature)
LITELLM_KEY=your-api-key-here
# RAG_LITELLM_ENABLED=true

# Search Configuration
# RAG_DEFAULT_TOP_K=3

# Debug Mode
# RAG_DEBUG=false
